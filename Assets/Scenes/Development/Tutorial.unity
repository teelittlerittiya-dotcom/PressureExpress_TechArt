--- !u!114 &145140639
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 145140638}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17e2927520b19044db99370da30068c4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PressureExpress.Tutorial.TutorialMinigameOverlay
  dialoguePanel: {fileID: 1998734175}
  titleText: {fileID: 980223568}
  dialogueText: {fileID: 1358017245}
  pageIndicatorText: {fileID: 241877889}
  typewriter: {fileID: 1358017244}
  textAnimator: {fileID: 1358017243}
  nextButton: {fileID: 1267993109}
  prevButton: {fileID: 1833643805}
  dismissButton: {fileID: 1195364932}
  closeButton: {fileID: 1206761794}
  highlightFrame: {fileID: 612876582}
  highlightImage: {fileID: 612876580}
  bounceSpeed: 6
  bounceDistance: 12
  pointerYOffset: 50
  guideConfigs:
  - uiType: 1
    machineTitle: FUEL CONVERTER
    steps:
    - text: Powers the submarine's engines and life-support systems by converting
        stored fuel stock into reactor power.
      targetControlName: 
    - text: Hold <color=#4ef>SPACE</color> to recharge and convert stored fuel stock
        into reactor power!
      targetControlName: FuelSlider
    - text: Click the <color=#ff4>Mode Button</color> to toggle between <b>Normal
        Mode</b> (fast conversion, higher heat) and <b>Safe Mode</b> (slower conversion,
        low heat).
      targetControlName: Mode
  - uiType: 2
    machineTitle: OXYGEN GENERATOR
    steps:
    - text: Extracts water directly from the submarine's <b>Ballast Tanks</b> and
        electrolyzes it into breathable oxygen for the crew.
      targetControlName: 
    - text: 'Hold <color=#4ef>SPACE</color>, <color=#4ef>W</color>, or drag the <b>Water
        Slider</b> down to fill the chamber. <color=#ffb>Warning</color>: Oxygen
        generation consumes ballast water!'
      targetControlName: Handle
    - text: Click <color=#4f4>GENERATE</color> (or BOOST) to produce oxygen. If ballast
        water gets too low, pump water back in via the Bilge Pump station!
      targetControlName: GenerationButton
  - uiType: 4
    machineTitle: CORE TEMPERATURE VALVE
    steps:
    - text: Controls heating and cooling for <b>ALL ROOMS</b> in the submarine, balancing
        internal engine heat against icy sea water.
      targetControlName: 
    - text: Hold <color=#4ef>A / LEFT ARROW</color> to open coolant valve and cool
        all rooms. Hold <color=#f44>D / RIGHT ARROW</color> to warm up the submarine.
      targetControlName: Valve
    - text: "Keep the temperature gauge needle steady in the safe green zone (20\xB0C\u201370\xB0C)
        to prevent catastrophic fires or frozen equipment!"
      targetControlName: CurrentTempText
  - uiType: 3
    machineTitle: HULL PRESSURE STABILIZER
    steps:
    - text: Deep ocean depth exerts immense hydrostatic pressure. This stabilizer
        calibrates pressure release valves across the hull.
      targetControlName: 
    - text: Watch the moving needle. Press <color=#4f4>SPACE</color> or <color=#4f4>LEFT
        CLICK</color> when it reaches a colored zone.
      targetControlName: needle
    - text: '<color=#FFD700>YELLOW</color> is the <b>GOOD</b> zone: hit it to reduce
        hull stress by <color=#FFD700>15%</color>. <color=#39FF14>GREEN</color> is
        the <b>GREAT</b> zone: hit it to reduce hull stress by <color=#39FF14>25%</color>.'
      targetControlName: 
    - text: Missing both zones adds <color=#f44>5% hull stress</color>. Great and
        Good hits complete the pressure task. Keep stress low to prevent a breach!
      targetControlName: 
  - uiType: 5
    machineTitle: BILGE WATER DRAIN PUMP
    steps:
    - text: Expels compartment floodwater and regulates <b>Ballast Tank levels</b>
        to control diving and surfacing.
      targetControlName: 
    - text: Press <color=#ff4>T</color> or click <color=#ff4>CHANGE MODE</color>
        to toggle modes. In Drain mode, mash <color=#4ef>SPACE</color> or click <color=#4ef>PUMP
        OUT</color> to pump room water out!
      targetControlName: PumpOut
    - text: Since Oxygen consumes ballast water, keep ballast tanks balanced around
        50% so the submarine remains buoyant and steerable!
      targetControlName: 
  - uiType: 6
    machineTitle: SONAR & HELM NAVIGATION
    steps:
    - text: The Command Helm steers the submarine through deep ocean trenches, detects
        terrain obstacles, and tracks navigation waypoints.
      targetControlName: 
    - text: Steer the submarine horizontally using <color=#4f4>A</color> (Left) and
        <color=#4f4>D</color> (Right). Press <color=#4ef>SPACE</color> to fire an
        active <b>SONAR PING</b>!
      targetControlName: BT_NAV
    - text: Yellow blips reveal rock obstacles. Follow the labeled <b>EXIT BEACON</b>
        waypoint marker and steer until distance reaches <b>0m</b> to complete the
        tutorial!
      targetControlName: 
